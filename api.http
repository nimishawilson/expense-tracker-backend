### Expense Tracker Backend — User Management API
### Requires the VS Code "REST Client" extension (humao.rest-client).
### Click "Send Request" above each block. Run them top to bottom —
### the login request captures a token that later requests reuse.
### Make sure the server is running first: npm run start:dev

@baseUrl = http://localhost:3000
@contentType = application/json

########################################
# AUTH — POST /auth/register
########################################

### Register — success (expect 201, no password in response)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Jane Doe",
  "email": "jane@example.com",
  "password": "secret1",
  "confirmPassword": "secret1"
}

### Register — duplicate email (expect 409 Conflict)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Jane Doe",
  "email": "jane@example.com",
  "password": "secret1",
  "confirmPassword": "secret1"
}

### Register — invalid name, contains digits (expect 400)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Jane123",
  "email": "jane2@example.com",
  "password": "secret1",
  "confirmPassword": "secret1"
}

### Register — password too short (expect 400)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Jane Doe",
  "email": "jane3@example.com",
  "password": "abc",
  "confirmPassword": "abc"
}

### Register — confirmPassword mismatch (expect 400)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Jane Doe",
  "email": "jane4@example.com",
  "password": "secret1",
  "confirmPassword": "different"
}

### Register — extra/unknown field rejected by whitelist (expect 400)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Jane Doe",
  "email": "jane5@example.com",
  "password": "secret1",
  "confirmPassword": "secret1",
  "role": "admin"
}

########################################
# AUTH — POST /auth/login
########################################

### Login — wrong password (expect 401)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "jane@example.com",
  "password": "wrongpassword"
}

### Login — unknown email (expect 401, same generic message)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "doesnotexist@example.com",
  "password": "secret1"
}

### Login — success (expect 200, returns accessToken + user)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "nim@example.com",
  "password": "secret1"
}

###

@authToken = {{login.response.body.$.accessToken}}
@authUserId = {{login.response.body.$.user.id}}

########################################
# USERS — GET /users/me
########################################

### Get profile — no token (expect 401)
GET {{baseUrl}}/users/me

### Get profile — invalid/garbage token (expect 401)
GET {{baseUrl}}/users/me
Authorization: Bearer this.is.not.a.valid.token

### Get profile — valid token (expect 200, includes defaultCurrency/timeZone)
GET {{baseUrl}}/users/me
Authorization: Bearer {{authToken}}

########################################
# USERS — PATCH /users/me
########################################

### Update profile — name + preferences (expect 200, updated fields returned)
PATCH {{baseUrl}}/users/me
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Jane Q Doe",
  "defaultCurrency": "INR",
  "timeZone": "Asia/Kolkata"
}

### Update profile — partial update, name only (expect 200)
PATCH {{baseUrl}}/users/me
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Jane Doe"
}

### Update profile — invalid currency code (expect 400)
PATCH {{baseUrl}}/users/me
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "defaultCurrency": "rupees"
}

### Update profile — attempt to change email (expect 400, email is read-only)
PATCH {{baseUrl}}/users/me
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "email": "hacker@example.com"
}

########################################
# USERS — PATCH /users/me/password
########################################

### Change password — wrong current password (expect 401)
PATCH {{baseUrl}}/users/me/password
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "currentPassword": "wrongone",
  "newPassword": "newsecret1",
  "confirmNewPassword": "newsecret1"
}

### Change password — confirm mismatch (expect 400)
PATCH {{baseUrl}}/users/me/password
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "currentPassword": "secret1",
  "newPassword": "newsecret1",
  "confirmNewPassword": "different"
}

### Change password — success (expect 200, success message)
PATCH {{baseUrl}}/users/me/password
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "currentPassword": "secret1",
  "newPassword": "newsecret1",
  "confirmNewPassword": "newsecret1"
}

### Login again with the NEW password to confirm the change took effect (expect 200)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "nim@example.com",
  "password": "newsecret1"
}

### Old password should now fail (expect 401)
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "nim@example.com",
  "password": "secret1"
}

########################################
# Second user, used below as a split participant
########################################

### Register second user — Bob (expect 201)
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Bob Smith",
  "email": "bob@example.com",
  "password": "secret1",
  "confirmPassword": "secret1"
}

### Login as Bob (expect 200)
# @name loginBob
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "bob@example.com",
  "password": "secret1"
}

###

@bobToken = {{loginBob.response.body.$.accessToken}}
@bobId = {{loginBob.response.body.$.user.id}}

########################################
# CATEGORIES — POST /categories
########################################

### Create custom category (expect 201)
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Hobbies",
  "icon": "🎨"
}

###

@categoryId = {{createCategory.response.body.$.id}}

### Create category — duplicate name for the same user (expect 409)
POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Hobbies"
}

### Create category — missing name (expect 400)
POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "icon": "🎨"
}

########################################
# CATEGORIES — GET /categories
########################################

### List categories — defaults + own custom (expect 200)
GET {{baseUrl}}/categories
Authorization: Bearer {{authToken}}

### Get a single default category (expect 200) — replace :id with one from the list above
GET {{baseUrl}}/categories/1
Authorization: Bearer {{authToken}}

### Get another user's custom category (expect 404, not visible)
GET {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{bobToken}}

########################################
# CATEGORIES — PATCH /categories/:id
########################################

### Update own custom category (expect 200)
PATCH {{baseUrl}}/categories/{{categoryId}}
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Hobbies & Crafts"
}

### Update a default category (expect 403, defaults are immutable)
PATCH {{baseUrl}}/categories/1
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "name": "Renamed Default"
}

### Update another user's custom category (expect 404, not visible)
PATCH {{baseUrl}}/categories/{{categoryId}}
Content-Type: {{contentType}}
Authorization: Bearer {{bobToken}}

{
  "name": "Hijacked"
}

########################################
# EXPENSES — POST /expenses
########################################

### Create a personal expense, no split (expect 201)
# @name createPersonalExpense
POST {{baseUrl}}/expenses
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "amount": 24.50,
  "description": "Solo lunch",
  "date": "2026-09-20T00:00:00.000Z",
  "categoryId": {{categoryId}}
}

###

@personalExpenseId = {{createPersonalExpense.response.body.$.id}}

### Create expense — missing categoryId (expect 400, category is required)
POST {{baseUrl}}/expenses
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "amount": 24.50,
  "description": "Solo lunch",
  "date": "2026-09-20T00:00:00.000Z"
}

### Create an EQUAL split expense with Bob (expect 201, shares split 50/50)
# @name createEqualSplitExpense
POST {{baseUrl}}/expenses
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "amount": 40.00,
  "description": "Team lunch",
  "date": "2026-09-20T00:00:00.000Z",
  "categoryId": {{categoryId}},
  "splitType": "EQUAL",
  "participants": [
    { "userId": {{authUserId}} },
    { "userId": {{bobId}} }
  ]
}

### Create a PERCENTAGE split expense (expect 201, 60/40)
POST {{baseUrl}}/expenses
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "amount": 100.00,
  "description": "Groceries run",
  "date": "2026-09-21T00:00:00.000Z",
  "categoryId": {{categoryId}},
  "paidById": {{bobId}},
  "splitType": "PERCENTAGE",
  "participants": [
    { "userId": {{authUserId}}, "value": 60 },
    { "userId": {{bobId}}, "value": 40 }
  ]
}

### Create an EXACT split expense with amounts that don't sum to the total (expect 400)
POST {{baseUrl}}/expenses
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "amount": 50.00,
  "description": "Broken exact split",
  "date": "2026-09-21T00:00:00.000Z",
  "categoryId": {{categoryId}},
  "splitType": "EXACT",
  "participants": [
    { "userId": {{authUserId}}, "value": 20 },
    { "userId": {{bobId}}, "value": 20 }
  ]
}

### Create a SHARES split expense with an unresolvable participant (expect 400)
POST {{baseUrl}}/expenses
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "amount": 90.00,
  "description": "Trip supplies",
  "date": "2026-09-22T00:00:00.000Z",
  "categoryId": {{categoryId}},
  "splitType": "SHARES",
  "participants": [
    { "userId": 999999, "value": 1 },
    { "userId": {{bobId}}, "value": 2 }
  ]
}

########################################
# EXPENSES — GET /expenses
########################################

### List my expenses (expect 200, includes both personal and split expenses)
GET {{baseUrl}}/expenses
Authorization: Bearer {{authToken}}

### List with filters — category + date range + pagination (expect 200)
GET {{baseUrl}}/expenses?categoryId={{categoryId}}&fromDate=2026-09-01T00:00:00.000Z&toDate=2026-09-30T23:59:59.000Z&page=1&limit=10
Authorization: Bearer {{authToken}}

### List Bob's expenses — should include the shared expense as a participant (expect 200)
GET {{baseUrl}}/expenses
Authorization: Bearer {{bobToken}}

########################################
# EXPENSES — GET /expenses/:id
########################################

### Get the split expense as owner (expect 200)
GET {{baseUrl}}/expenses/{{createEqualSplitExpense.response.body.$.id}}
Authorization: Bearer {{authToken}}

### Get the split expense as Bob, the participant (expect 200)
GET {{baseUrl}}/expenses/{{createEqualSplitExpense.response.body.$.id}}
Authorization: Bearer {{bobToken}}

### Get the personal (unshared) expense as Bob, an unrelated user (expect 404)
GET {{baseUrl}}/expenses/{{personalExpenseId}}
Authorization: Bearer {{bobToken}}

########################################
# EXPENSES — PATCH /expenses/:id
########################################

### Update the split expense's amount as owner (expect 200, shares rescale proportionally)
PATCH {{baseUrl}}/expenses/{{createEqualSplitExpense.response.body.$.id}}
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "amount": 60.00
}

### Update as Bob, a participant but not the owner (expect 403)
PATCH {{baseUrl}}/expenses/{{createEqualSplitExpense.response.body.$.id}}
Content-Type: {{contentType}}
Authorization: Bearer {{bobToken}}

{
  "description": "Hijacked description"
}

########################################
# EXPENSES — DELETE /expenses/:id
########################################

### Delete the personal expense as owner (expect 200)
DELETE {{baseUrl}}/expenses/{{personalExpenseId}}
Authorization: Bearer {{authToken}}

### Re-fetch the deleted expense (expect 404)
GET {{baseUrl}}/expenses/{{personalExpenseId}}
Authorization: Bearer {{authToken}}

########################################
# CATEGORIES — DELETE /categories/:id
########################################

### Delete a category still referenced by an expense (expect 409)
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{authToken}}

### Delete a default category (expect 403)
DELETE {{baseUrl}}/categories/1
Authorization: Bearer {{authToken}}

########################################
# BALANCES — GET /balances (before settling up)
########################################

### Balances for me — should show Bob owing me from the EQUAL split expense (expect 200)
GET {{baseUrl}}/balances
Authorization: Bearer {{authToken}}

### Balances for Bob — should show the mirrored negative net (expect 200)
GET {{baseUrl}}/balances
Authorization: Bearer {{bobToken}}

########################################
# SETTLEMENTS — POST /settlements
########################################

### Record a settlement as the fromUser party, Bob paying me back (expect 201)
# @name createSettlement
POST {{baseUrl}}/settlements
Content-Type: {{contentType}}
Authorization: Bearer {{bobToken}}

{
  "fromUserId": {{bobId}},
  "toUserId": {{authUserId}},
  "amount": 10.00,
  "note": "Paid back via UPI"
}

### Record a settlement as the toUser party instead (expect 201)
POST {{baseUrl}}/settlements
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "fromUserId": {{bobId}},
  "toUserId": {{authUserId}},
  "amount": 5.00
}

### Record a settlement between two users, neither of which is me (expect 403)
POST {{baseUrl}}/settlements
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "fromUserId": {{bobId}},
  "toUserId": 999999,
  "amount": 5.00
}

### Record a settlement with fromUserId === toUserId (expect 400)
POST {{baseUrl}}/settlements
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "fromUserId": {{authUserId}},
  "toUserId": {{authUserId}},
  "amount": 5.00
}

### Record a settlement with a nonexistent toUserId (expect 404)
POST {{baseUrl}}/settlements
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "fromUserId": {{authUserId}},
  "toUserId": 999999,
  "amount": 5.00
}

### Record a settlement with a negative amount (expect 400)
POST {{baseUrl}}/settlements
Content-Type: {{contentType}}
Authorization: Bearer {{authToken}}

{
  "fromUserId": {{bobId}},
  "toUserId": {{authUserId}},
  "amount": -5.00
}

########################################
# SETTLEMENTS — GET /settlements
########################################

### List my settlements — both directions included (expect 200)
GET {{baseUrl}}/settlements
Authorization: Bearer {{authToken}}

### List settlements filtered to Bob as counterpart (expect 200)
GET {{baseUrl}}/settlements?counterpartUserId={{bobId}}
Authorization: Bearer {{authToken}}

########################################
# BALANCES — GET /balances (after settling up)
########################################

### Balances for me — net should have moved toward zero by the settled amount (expect 200)
GET {{baseUrl}}/balances
Authorization: Bearer {{authToken}}

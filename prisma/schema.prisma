// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  password String

  defaultCurrency String @default("USD")

  timeZone String @default("UTC")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  categories Category[]

  ownedExpenses Expense[] @relation("ExpenseOwner")

  paidExpenses Expense[] @relation("ExpensePaidBy")

  expenseShares ExpenseParticipant[]

  settlementsSent Settlement[] @relation("SettlementFrom")

  settlementsReceived Settlement[] @relation("SettlementTo")

  friendRequestsSent FriendRequest[]

  friendships Friendship[] @relation("FriendshipOwner")

  friendOf Friendship[] @relation("FriendshipFriend")
}

enum SplitType {
  EQUAL
  PERCENTAGE
  EXACT
  SHARES
}

model Category {
  id Int @id @default(autoincrement())

  name String

  icon String?

  isDefault Boolean @default(false)

  userId Int?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id Int @id @default(autoincrement())

  amount Decimal @db.Decimal(12, 2)

  description String

  date DateTime

  categoryId Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  ownerId Int

  owner User @relation("ExpenseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  paidById Int

  paidBy User @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  splitType SplitType?

  participants ExpenseParticipant[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([categoryId])
  @@index([date])
}

model ExpenseParticipant {
  id Int @id @default(autoincrement())

  expenseId Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shareAmount Decimal @db.Decimal(12, 2)

  inputValue Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id Int @id @default(autoincrement())

  fromUserId Int

  fromUser User @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)

  toUserId Int

  toUser User @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(12, 2)

  note String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model FriendRequest {
  id Int @id @default(autoincrement())

  senderId Int

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Lower-case; the recipient may not have an account yet.
  receiverEmail String

  // SHA-256 of the emailed token; the raw token is never stored.
  tokenHash String @unique

  status FriendRequestStatus @default(PENDING)

  expiresAt DateTime

  lastSentAt DateTime

  sendCount Int @default(1)

  respondedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverEmail])
  @@index([receiverEmail, status])
}

// Symmetric: an accepted friendship is stored as two rows (A->B and B->A).
model Friendship {
  id Int @id @default(autoincrement())

  userId Int

  user User @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)

  friendId Int

  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId])
}

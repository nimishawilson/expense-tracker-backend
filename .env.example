DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5433/DATABASE_NAME?schema=public"
PORT=3000
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Friend requests (emails). Local dev: `docker compose up -d` starts Mailpit,
# which catches mail on SMTP 1025 and shows it at http://localhost:8025.
FRONTEND_URL="http://localhost:5173"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Expense Tracker <no-reply@expense-tracker.local>"
FRIEND_REQUEST_TTL_DAYS=7
